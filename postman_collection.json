{
  "info": {
    "name": "Microservices Security Demo (Session 14)",
    "_postman_id": "c1f7a0b5-77ef-4182-990a-20fa94bf5521",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth Service",
      "item": [
        {
          "name": "1.1 Register USER",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_demo\",\n  \"password\": \"123456\",\n  \"roles\": [\"ROLE_USER\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Register ADMIN",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin_demo\",\n  \"password\": \"123456\",\n  \"roles\": [\"ROLE_ADMIN\", \"ROLE_USER\"]\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "1.3 Login (Get Access & Refresh Token)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"user_demo\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "1.4 Refresh Token (Rotation)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{current_refresh_token}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/refresh-token",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "refresh-token"]
            }
          }
        },
        {
          "name": "1.5 Logout (Redis Blacklist)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accessToken\": \"{{current_access_token}}\",\n  \"refreshToken\": \"{{current_refresh_token}}\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Order Service (Phân Quyền RBAC)",
      "item": [
        {
          "name": "2.1 Xem tất cả đơn hàng (USER & ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{current_access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "2.2 Tạo đơn hàng mới (USER & ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{current_access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productName\": \"Khóa học Microservices Spring Boot\",\n  \"price\": 2500000\n}"
            },
            "url": {
              "raw": "http://localhost:8080/api/orders",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "orders"]
            }
          }
        },
        {
          "name": "2.3 Xóa đơn hàng (CHỈ ADMIN - USER bị 403 Forbidden)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{current_access_token}}" }
            ],
            "url": {
              "raw": "http://localhost:8080/api/orders/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["api", "orders", "1"]
            }
          }
        }
      ]
    }
  ]
}
